{
  "manifest_version": 3,
  "name": "Stock Signal Alert",
  "version": "0.7.2",
  "description": "Watch daily stock signals and receive deduplicated browser alerts.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://push2.eastmoney.com/*", "https://push2his.eastmoney.com/*", "https://smartbox.gtimg.cn/*", "https://web.ifzq.gtimg.cn/*", "https://proxy.finance.qq.com/*", "https://qt.gtimg.cn/*"],
  "action": { "default_title": "Stock Signal Alert", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
